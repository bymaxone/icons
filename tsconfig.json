{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@bymax-one/icons": ["./src/index.ts"],
      "@bymax-one/icons/brands": ["./src/brands/index.ts"],
      "@bymax-one/icons/brands/*": ["./src/brands/generated/*.ts"],
      "@bymax-one/icons/flags": ["./src/flags/index.ts"],
      "@bymax-one/icons/flags/*": ["./src/flags/generated/*.ts"],
      "@bymax-one/icons/icons/*": ["./src/icons/generated/*/index.ts"],
      "@bymax-one/icons/grid": ["./src/grid/index.ts"],
      "@bymax-one/icons/meta": ["./src/meta/index.ts"],
      "@bymax-one/icons/native": ["./src/native/index.ts"],
      "@bymax-one/icons/native/brands": ["./src/native/brands/index.ts"],
      "@bymax-one/icons/native/brands/*": ["./src/native/generated/brands/*.ts"],
      "@bymax-one/icons/native/flags": ["./src/native/flags/index.ts"],
      "@bymax-one/icons/native/flags/*": ["./src/native/generated/flags/*.ts"],
      "@bymax-one/icons/native/icons/*": ["./src/native/generated/icons/*/index.ts"],
      "@bymax-one/icons/native/runtime": ["./src/native/runtime/index.ts"],
      "@bymax-one/icons/runtime": ["./src/runtime/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/native"]
}
